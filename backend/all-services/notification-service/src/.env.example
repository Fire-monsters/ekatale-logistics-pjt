# services/notification-service/.env.example

NODE_ENV="development"
PORT=3003

# MUST match auth-service's JWT_ACCESS_SECRET
JWT_ACCESS_SECRET="4620aa8bee1bd8a19bdf6cd5345446650752a2bd40592eff9c1700258e4f3877fa36fb401e17a049d639b723cf9115b94d726bc71b458730981c12b1eccef7a7"

# Shared secret for service-to-service calls (e.g. listing-service -> notification-service)
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY="replace-with-a-long-random-string"

# ── Firebase ─────────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Paste the ENTIRE JSON file contents as a single line below.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"ekatale-xxxx", ... }'

# ── Africa's Talking (SMS) ───────────────────────────────────────────────────
AT_API_KEY="atsk_d2399f4d373793a72c3b31b57f46cb7f55e259750eea710126962f2ff467540c894d216e"
AT_USERNAME="sandbox"
AT_SENDER_ID="E-Katale"