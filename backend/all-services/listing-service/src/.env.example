# services/listing-service/.env.example

DATABASE_LISTINGS_URL="postgresql://admin:dev2026@localhost:5432/ekatale?schema=listings"

# MUST match auth-service's JWT_ACCESS_SECRET — tokens are minted by
# auth-service and verified here without a network round-trip.
JWT_ACCESS_SECRET="4620aa8bee1bd8a19bdf6cd5345446650752a2bd40592eff9c1700258e4f3877fa36fb401e17a049d639b723cf9115b94d726bc71b458730981c12b1eccef7a7"

NODE_ENV="development"
PORT=3002

# Local photo storage (swap for S3/R2 bucket + CDN URL in production)
UPLOAD_DIR="./uploads"
UPLOAD_PUBLIC_URL="http://localhost:3002/uploads"

# notification-service (status-change push/SMS to farmers)
NOTIFICATION_SERVICE_URL="http://localhost:3003"
# MUST match notification-service's INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_KEY="replace-with-a-long-random-string"